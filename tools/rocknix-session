"""Compatibility command for existing ROCKNIX scripts.

All process supervision now lives in the Rust poksession binary. This
wrapper only translates the original command-line spelling. exec() means
there is no second supervisor, polling loop, or orphan-prone Python parent.
"""
import argparse
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SESSION = ROOT / "rust/target/debug/poksession"

def main():
    parser = argparse.ArgumentParser(
        description="Attach poksession to an existing Wayland/Sway compositor")
    parser.add_argument("--display", required=True)
    parser.add_argument("--game", required=True)
    parser.add_argument("--game-arg", action="append", default=[])
    parser.add_argument("--daemon")
    parser.add_argument("--layer")
    parser.add_argument("--socket")
    options = parser.parse_args()
    args = [str(SESSION), "--external-wayland", options.display,
            "--game", options.game]
    for arg in options.game_arg:
        args += ["--game-arg", arg]
    for opt in ("daemon", "layer", "socket"):
        value = getattr(options, opt)
        if value is not None:
            args += ["--" + opt, value]
    # Let Rust perform socket, user, child and inherited environment validation.
    os.execv(str(SESSION), args)

if __name__ == "__main__":
    main()
